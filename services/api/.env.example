# Owner role: runs migrations and the narrowly scoped "system" lookups (tenant by slug, device enrolment).
DATABASE_URL=postgres://kinetix_owner:kinetix_owner@localhost:5432/kinetix
# Application role: subject to row-level security. All normal requests use this.
APP_DATABASE_URL=postgres://kinetix_app:kinetix_app@localhost:5432/kinetix
JWT_SECRET=change-me-to-a-long-random-string
PAIRING_HMAC_SECRET=change-me-too
PORT=4000
DEFAULT_TIMEZONE=Asia/Kolkata
