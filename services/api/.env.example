# Owner role: runs migrations and the narrowly scoped "system" lookups (tenant by slug, device enrolment).
DATABASE_URL=postgres://kinetix_owner:kinetix_owner@localhost:5432/kinetix
# Application role: subject to row-level security. All normal requests use this.
APP_DATABASE_URL=postgres://kinetix_app:kinetix_app@localhost:5432/kinetix
JWT_SECRET=change-me-to-a-long-random-string
PAIRING_HMAC_SECRET=change-me-too
PORT=4000
DEFAULT_TIMEZONE=Asia/Kolkata
# AI, local first (docs/operations/ai-hosting.md). Everything must be processed in India.
# Primary: a self-hosted OpenAI-compatible model server (vLLM on a college GPU box or E2E Networks).
# With no primary and no fallback, AI tasks return labelled previews.
# AI_BASE_URL=http://10.0.0.12:8000/v1
# AI_MODEL=kinetix-llm
# AI_API_KEY=
# AI_VISION=true                 # the primary reads board images (readBoard)
# AI_TIMEOUT_MS=60000
# Fallback: Sarvam AI pay-per-use, on connection errors, timeouts, 5xx and 429 (never on a 4xx).
# Alone (no AI_BASE_URL) it is the only provider: the pilot setup.
# AI_FALLBACK_PROVIDER=sarvam
# AI_BREAKER_FAILURES=3          # skip the primary after this many failures in a row...
# AI_BREAKER_COOLDOWN_S=60       # ...for this long
# AI_DAILY_LIMIT=2000            # model requests per institution per day
# Speech-to-text for lesson transcripts: self-hosted (faster-whisper / IndicConformer), then Sarvam.
# ASR_BASE_URL=http://10.0.0.13:8000/v1
# ASR_MODEL=whisper
# ASR_FALLBACK_PROVIDER=sarvam
# ASR_MONTHLY_HOURS=300          # transcription hours per institution per month (0 = no cap)
# Sarvam AI (Bengaluru). Rates are for cost estimates in logs and ai_usage; check the current price list.
# SARVAM_API_KEY=
# SARVAM_LLM_MODEL=sarvam-105b
# SARVAM_ASR_MODEL=saaras:v3
# SARVAM_INR_PER_M_INPUT=29.28
# SARVAM_INR_PER_M_OUTPUT=73.2
# SARVAM_INR_PER_AUDIO_HOUR=30
# Recording storage: local disk for development; s3 (ap-south-1) in production.
STORAGE_DRIVER=local
STORAGE_DIR=.data/objects
# S3_BUCKET=kinetix-recordings-prod
# Push notifications (Firebase service account JSON or a path to it). Pushes carry ids only.
# FCM_SERVICE_ACCOUNT=/etc/kinetix/fcm-service-account.json
# Online fee payments: demo (development, no money moves), razorpay, or none. With razorpay each
# institution enters its own Razorpay keys in the ERP (Settings → Online payments) and fees go
# straight to its account; there are no platform Razorpay keys.
PAYMENTS_PROVIDER=demo
# Master key that encrypts institutions' Razorpay secrets in the database (32 bytes, base64:
# openssl rand -base64 32). Required with PAYMENTS_PROVIDER=razorpay. Rotation: raise the version,
# move the old key to SECRETS_ENCRYPTION_OLD_KEYS, then `pnpm secrets:rotate`.
# SECRETS_ENCRYPTION_KEY=
# SECRETS_ENCRYPTION_KEY_VERSION=1
# SECRETS_ENCRYPTION_OLD_KEYS=1:<old base64 key>
# Local e2e only: fake Razorpay's API (no network); never in production.
# RAZORPAY_FAKE=true
# More than one API instance: Redis for shared rate limits, live-classroom state and the socket.io adapter.
# REDIS_URL=redis://localhost:6379
# Behind a load balancer: proxy hops to trust for the client IP (per-IP rate limits).
# TRUST_PROXY=1
# Logs: text (default) or json (one JSON object per line, for production log shipping).
# LOG_FORMAT=json
# Phone sign-in codes: console logs them (development); msg91 sends them (India, DLT template).
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=   # MSG91 Flow template linked to the DLT OTP template (variables ##otp## and ##app##)
# MSG91_SENDER_ID=KINTIX
# SMS_APP_NAME=KINETIX
# Concept videos: a YouTube Data API v3 key (Google Cloud) lets the platform team import playlists
# and see durations. Optional; without it videos are added one link at a time.
# YOUTUBE_API_KEY=
# PhET sims: our mirror in India (infra/terraform/phet.tf, docs/operations/phet.md). Unset: boards
# download from phet.colorado.edu.
# PHET_MIRROR_URL=https://dxxxxxxxx.cloudfront.net/phet
