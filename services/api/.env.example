# Owner role: runs migrations and the narrowly scoped "system" lookups (tenant by slug, device enrolment).
DATABASE_URL=postgres://kinetix_owner:kinetix_owner@localhost:5432/kinetix
# Application role: subject to row-level security. All normal requests use this.
APP_DATABASE_URL=postgres://kinetix_app:kinetix_app@localhost:5432/kinetix
JWT_SECRET=change-me-to-a-long-random-string
PAIRING_HMAC_SECRET=change-me-too
PORT=4000
DEFAULT_TIMEZONE=Asia/Kolkata
# AI model server, OpenAI-compatible (vLLM / llama.cpp), hosted in India. Leave unset for previews.
# AI_BASE_URL=http://10.0.0.12:8000/v1
# AI_MODEL=kinetix-llm
# AI_API_KEY=
# Speech-to-text for lesson transcripts (OpenAI-compatible, e.g. faster-whisper-server), in India.
# ASR_BASE_URL=http://10.0.0.13:8000/v1
# Recording storage: local disk for development; s3 (ap-south-1) in production.
STORAGE_DRIVER=local
STORAGE_DIR=.data/objects
# S3_BUCKET=kinetix-recordings-prod
# Push notifications (Firebase service account JSON or a path to it). Pushes carry ids only.
# FCM_SERVICE_ACCOUNT=/etc/kinetix/fcm-service-account.json
# Online fee payments: demo (development, no money moves), razorpay, or none.
PAYMENTS_PROVIDER=demo
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# More than one API instance: Redis for shared rate limits, live-classroom state and the socket.io adapter.
# REDIS_URL=redis://localhost:6379
# Behind a load balancer: proxy hops to trust for the client IP (per-IP rate limits).
# TRUST_PROXY=1
# Logs: text (default) or json (one JSON object per line, for production log shipping).
# LOG_FORMAT=json
# Phone sign-in codes: console logs them (development); msg91 sends them (India, DLT template).
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=   # MSG91 Flow template linked to the DLT OTP template (variables ##otp## and ##app##)
# MSG91_SENDER_ID=KINTIX
# SMS_APP_NAME=KINETIX
