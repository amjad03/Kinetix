   "name": {
    "en": "Kinds of joints",
    "hi": "जोड़ों के प्रकार",
    "kn": "ಕೀಲುಗಳ ಪ್ರಕಾರಗಳು"
   },
   "steps": [
    {
     "highlight": [
      "upper_arm",
      "shoulder_blades",
      "thigh",
      "pelvis"
     ],
     "text": {
      "en": "Ball-and-socket joints (shoulder, hip): the round end of one bone turns in a cup of another, in every direction.",
      "hi": "कंदुक-खल्लिका जोड़ (कंधा, कूल्हा): एक हड्डी का गोल सिरा दूसरी हड्डी के कटोरे में हर दिशा में घूमता है।",
      "kn": "ಚೆಂಡು-ಗುಳಿ ಕೀಲುಗಳು (ಭುಜ, ಸೊಂಟ): ಒಂದು ಮೂಳೆಯ ದುಂಡು ತುದಿ ಇನ್ನೊಂದರ ಬಟ್ಟಲಿನಲ್ಲಿ ಎಲ್ಲ ದಿಕ್ಕುಗಳಲ್ಲಿ ತಿರುಗುತ್ತದೆ."
     }
    },
    {
     "highlight": [
      "upper_arm",
      "forearm",
      "thigh",
      "shin",
      "kneecap"
     ],
     "text": {
      "en": "Hinge joints (elbow, knee): they move one way only, like a door on its hinges.",
      "hi": "कब्ज़ा जोड़ (कोहनी, घुटना): ये केवल एक दिशा में मुड़ते हैं, जैसे कब्ज़े पर दरवाज़ा।",
      "kn": "ಹಿಂಜ್ ಕೀಲುಗಳು (ಮೊಣಕೈ, ಮಂಡಿ): ಬಾಗಿಲಿನಂತೆ ಒಂದೇ ದಿಕ್ಕಿನಲ್ಲಿ ಚಲಿಸುತ್ತವೆ."
     }
    },
    {
     "highlight": [
      "skull",
      "spine"
     ],
     "text": {
      "en": "Pivot joint (neck): the head turns left and right on the top of the backbone.",
      "hi": "धुराग्र जोड़ (गर्दन): सिर मेरुदंड के ऊपरी सिरे पर दाएँ-बाएँ घूमता है।",
      "kn": "ಅಚ್ಚು ಕೀಲು (ಕುತ್ತಿಗೆ): ತಲೆ ಬೆನ್ನುಮೂಳೆಯ ಮೇಲ್ತುದಿಯಲ್ಲಿ ಎಡ-ಬಲ ತಿರುಗುತ್ತದೆ."
     }
    },
    {
     "highlight": [
      "hands",
      "feet"
     ],
     "text": {
      "en": "Gliding joints (wrist, ankle): small flat bones slide over one another.",
      "hi": "सरकने वाले जोड़ (कलाई, टखना): छोटी चपटी हड्डियाँ एक-दूसरे पर सरकती हैं।",
      "kn": "ಜಾರುವ ಕೀಲುಗಳು (ಮಣಿಕಟ್ಟು, ಕಣಕಾಲು): ಸಣ್ಣ ಚಪ್ಪಟೆ ಮೂಳೆಗಳು ಒಂದರ ಮೇಲೊಂದು ಜಾರುತ್ತವೆ."
     }
    },
    {
     "highlight": [
      "skull"
     ],
     "text": {
      "en": "Fixed joints (skull): the bones are locked together and do not move.",
      "hi": "अचल जोड़ (खोपड़ी): हड्डियाँ आपस में जुड़ी रहती हैं और हिलती नहीं।",
      "kn": "ಅಚಲ ಕೀಲುಗಳು (ತಲೆಬುರುಡೆ): ಮೂಳೆಗಳು ಬಿಗಿಯಾಗಿ ಸೇರಿವೆ, ಚಲಿಸುವುದಿಲ್ಲ."
     }
    }
   ]
