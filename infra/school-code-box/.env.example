# Copy to .env next to docker-compose.yml and change what you need.
# A key the boards must send (Settings → School code box → Key). Leave empty on a closed lab network.
CODE_BOX_KEY=
# What the boards show for this box.
CODE_BOX_NAME=Computer lab PC
# The port boards connect to.
CODE_BOX_PORT=8181
# Between the gateway and the runner only; any long random text.
CODE_RUNNER_TOKEN=change-me-to-something-random
# Programs at once; about one per CPU core of this PC.
RUN_CONCURRENCY=2
RUNNER_CPUS=2
RUNNER_MEMORY=1g
# Runs per board per minute.
RUN_PER_MINUTE=30
