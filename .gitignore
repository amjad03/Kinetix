# PhET catalogue build cache (tools/phet/build-catalogue.mjs)
tools/phet/.cache/

# bundled sims ship their own build/ folders
!apps/board/assets/simhub/**/build/

# Classroom edition: Zynetix School lesson parts, written at build time (never committed).
apps/board/assets/private/lessons/*
!apps/board/assets/private/lessons/README.txt
# Classroom edition Class tools: the question bank from Zynetix School, written at build time by
# apps/board/tool/build_class_bank.py (never committed).
apps/board/assets/private/class_tools/*
!apps/board/assets/private/class_tools/README.txt
