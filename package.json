{
  "name": "zynetix",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "api:dev": "pnpm --filter @zynetix/api start:dev",
    "api:test": "pnpm --filter @zynetix/api test",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5",
      "shell-quote": ">=1.11.0",
      "body-parser": ">=2.4.0",
      "multer": ">=2.5.0",
      "vite": "^8.3.3",
      "zod": "^4.6.7"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "@swc/core",
      "esbuild"
    ]
  }
}
