{"k1": [{"file": "k1_0.wav", "text": "Every morning, in thousands of classrooms, the same story begins.", "dur": 3.748, "anchor": false, "end": ".", "words": [["Every", 0.0, 0.32], ["morning,", 0.32, 0.868], ["in", 0.868, 1.051], ["thousands", 1.051, 1.554], ["of", 1.554, 1.737], ["classrooms,", 1.737, 2.422], ["the", 2.422, 2.651], ["same", 2.651, 2.925], ["story", 2.925, 3.245], ["begins.", 3.245, 3.748]]}], "s1": [{"file": "s1_0.wav", "text": "A teacher draws a heart on the board. It is flat. It is dusty. And by the next period, it is gone.", "dur": 5.945, "anchor": false, "end": ".", "words": [["A", 0.0, 0.136], ["teacher", 0.136, 0.545], ["draws", 0.545, 0.862], ["a", 0.862, 0.998], ["heart", 0.998, 1.316], ["on", 1.316, 1.498], ["the", 1.498, 1.725], ["board.", 1.725, 2.178], ["It", 2.178, 2.36], ["is", 2.36, 2.541], ["flat.", 2.541, 2.95], ["It", 2.95, 3.131], ["is", 3.131, 3.313], ["dusty.", 3.313, 3.767], ["And", 3.767, 3.994], ["by", 3.994, 4.175], ["the", 4.175, 4.402], ["next", 4.402, 4.674], ["period,", 4.674, 5.174], ["it", 5.174, 5.355], ["is", 5.355, 5.537], ["gone.", 5.537, 5.945]]}], "s2": [{"file": "s2_0.wav", "text": "Forty students. One explanation. A few follow. Most quietly drift away.", "dur": 4.765, "anchor": false, "end": ".", "words": [["Forty", 0.0, 0.367], ["students.", 0.367, 1.047], ["One", 1.047, 1.309], ["explanation.", 1.309, 2.147], ["A", 2.147, 2.304], ["few", 2.304, 2.566], ["follow.", 2.566, 3.142], ["Most", 3.142, 3.456], ["quietly", 3.456, 3.928], ["drift", 3.928, 4.294], ["away.", 4.294, 4.765]]}], "s3": [{"file": "s3_0.wav", "text": "Minutes go on calling names, one by one.", "dur": 2.309, "anchor": false, "end": ".", "words": [["Minutes", 0.0, 0.392], ["go", 0.392, 0.566], ["on", 0.566, 0.741], ["calling", 0.741, 1.133], ["names,", 1.133, 1.569], ["one", 1.569, 1.786], ["by", 1.786, 1.961], ["one.", 1.961, 2.309]]}], "s4": [{"file": "s4_0.wav", "text": "And tonight, she'll plan tomorrow's lesson by hand. Again.", "dur": 3.1