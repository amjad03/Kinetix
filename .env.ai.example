# Claude as the Zynetix board's AI. Paste your Anthropic key after AI_API_KEY= , save, close.
# This file (.env.ai) is git-ignored: the key stays on this Mac.
AI_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE
AI_MODEL=claude-sonnet-5-5
AI_FALLBACK_MODELS=claude-haiku-5-5
AI_VISION=true
