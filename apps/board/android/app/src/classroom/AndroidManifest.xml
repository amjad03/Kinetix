<!-- Zynetix Classroom (KINETIX_EDITION=classroom, applicationId in.zynetix.classroom, not
     in.kinetix.board): merged over src/main/AndroidManifest.xml and
     the plugins' manifests by android/app/build.gradle.kts. The edition has no camera, no
     microphone and no speech recognition (no document camera, lesson recording, noise meter,
     voice commands or live captions), so it asks for none of them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Updates without the Play Store (Settings → This board → App updates): hands a checked APK
         to Android's installer, which asks the teacher. Android refuses one signed by anyone else. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- "Open Zynetix when the board starts" (BootReceiver.kt): Android 10+ lets an app open itself
         after a restart only with "Display over other apps", which the teacher turns on in
         Android's settings when Settings → This board asks. Nothing is drawn over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-feature android:name="android.hardware.camera" tools:node="remove"/>
    <uses-feature android:name="android.hardware.camera.any" tools:node="remove"/>
    <queries>
        <!-- Whether the board has a print service (a printer app), to lead with Save when not. -->
        <intent>
            <action android:name="android.printservice.PrintService"/>
        </intent>
        <!-- Voice questions to KINETIX AI (speech_to_text): not in this edition. -->
        <intent tools:node="remove">
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
